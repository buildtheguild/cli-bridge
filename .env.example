# Shared secret used by n8n/clients
BRIDGE_TOKEN=change-this-to-a-long-random-string
CLI_BRIDGE_IMAGE=cli-bridge:latest

# Optional: when true, logs token fingerprints
LOG_TOKEN_FINGERPRINT=false

# Server
PORT=3900
# CORS: comma-separated allowed origins. Leave empty to allow all (default).
# Example: http://localhost:3900,https://your.domain.com
CORS_ORIGINS=
# Set true only when running behind a trusted reverse proxy that sets X-Forwarded-For.
# If false (default), X-Forwarded-For is ignored and the direct socket IP is used for rate limiting.
TRUST_PROXY=false
ENABLE_API_DOCS=true
# Optional OpenAPI "servers" list for Swagger UI (comma separated), e.g. https://api.example.com
API_DOCS_SERVERS=
API_DOCS_EXPANSION=list
APP_TITLE=CLIBridge
APP_DESCRIPTION=HTTP gateway for AI CLIs (Codex & Claude) with an OpenAI-compatible API, streaming, image support, and built-in audio transcription (Whisper service — audio never leaves this server).
APP_VERSION=1.0.0
APP_SERVICE_NAME=cli-bridge
HEALTH_VERBOSE_ENABLED=false
HEALTH_CODEX_TIMEOUT_MS=4000
MODELS_REFRESH_TIMEOUT_MS=30000
CLI_AUTH_TIMEOUT_MS=600000
CLI_AUTH_STATUS_TIMEOUT_MS=5000

# Insights scheduler (every 12 hours by default)
INSIGHTS_ENABLED=true
INSIGHTS_INTERVAL_HOURS=12
INSIGHTS_RUN_ON_START=true
INSIGHTS_HISTORY_LIMIT=30
INSIGHTS_USE_AI=true
INSIGHTS_MODEL=

# SMTP email for insight report delivery
INSIGHTS_EMAIL_ENABLED=false
INSIGHTS_EMAIL_COOLDOWN_MIN=15
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
SMTP_SUBJECT_PREFIX=[cli-bridge]

# CLI version update checks (npm registry — Codex/Claude)
CLI_UPDATE_CHECK_ENABLED=true
CLI_UPDATE_CHECK_INTERVAL_HOURS=6
CLI_UPDATE_REGISTRY_TIMEOUT_MS=8000
CLI_UPDATE_INSTALL_TIMEOUT_MS=180000
# Reuses the SMTP_* settings above
CLI_UPDATE_EMAIL_ENABLED=false

# Watchdog self-healing
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_SEC=60
WATCHDOG_MAX_CONSECUTIVE_UNHEALTHY=3
WATCHDOG_MAX_FAILURE_RATE_PCT=70
WATCHDOG_MAX_IDLE_MIN=0
WATCHDOG_RESTART_ON_CRITICAL=false
WATCHDOG_GRACE_SEC=120
WATCHDOG_EMAIL_ENABLED=false
WATCHDOG_ALERT_COOLDOWN_MIN=30

# Input/Output limits
MAX_SYSTEM_PROMPT_CHARS=20000
MAX_PROMPT_CHARS=30000
MAX_OUTPUT_CHARS=8000
# Summary output cap
MAX_SUMMARY_CHARS=1200
# Approximate token limit for input (0 disables)
MAX_INPUT_TOKENS=0
# Auto-summary trigger (0 disables)
SUMMARY_THRESHOLD_TOKENS=0
# Image token estimation (rough)
IMAGE_TOKEN_BASE=85
IMAGE_TOKEN_PER_TILE=170
REMOTE_IMAGE_FETCH_TIMEOUT_MS=5000
# Optional: override tiktoken encoding (e.g., o200k_base, cl100k_base, p50k_base)
TIKTOKEN_ENCODING=

# ── Backend selection ────────────────────────────────────────────────────────
# Which CLI to use: codex (default) | claude
# BACKEND=codex

# ── Codex CLI (used when BACKEND=codex) ──────────────────────────────────────
# On Windows you may need a full path, e.g. C:\Users\<you>\AppData\Roaming\npm\codex.cmd
CODEX_BIN=codex
CODEX_TIMEOUT_MS=120000
CODEX_DEFAULT_MODEL=
CODEX_ALLOWED_MODELS=
CODEX_SANDBOX=read-only
CODEX_ASK_FOR_APPROVAL=never
CODEX_ALLOW_SEARCH=false
CODEX_SKIP_GIT_REPO_CHECK=true
OPENAI_MODELS_HIDE_CODEX=true
# OpenAI-compatible /v1/chat/completions only: when true, an unknown requested
# model falls back to the active backend default instead of returning HTTP 400.
# If omitted entirely, the default behavior is enabled.
MODEL_FALLBACK_TO_DEFAULT_ON_UNKNOWN=true

# ── Claude CLI (used when BACKEND=claude) ────────────────────────────────────
# On Windows you may need a full path, e.g. C:\Users\<you>\AppData\Roaming\npm\claude.cmd
# Authenticate once inside the container: claude auth login
CLAUDE_BIN=claude
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-6
# Comma-separated allowlist; leave empty to allow any model
CLAUDE_ALLOWED_MODELS=

# ── Emergency OpenRouter fallback (optional, opt-in) ─────────────────────────
# Only used internally when the active CLI request fails with a known emergency
# condition such as auth loss, provider rate limiting, quota exhaustion, or
# provider unavailability. This is disabled by default because it uses paid API
# credits instead of your Codex/Claude subscription.
OPENROUTER_ENABLE_EMERGENCY_FALLBACK=false
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=
# Optional comma-separated fallback chain for OpenRouter's own routing
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_TIMEOUT_MS=45000
# Optional attribution headers
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=

# ── Audio transcription (POST /v1/audio/transcriptions, 100% local whisper.cpp — ─
# ── audio is never sent anywhere outside this container) ─────────────────────
# Binary and model are baked into the Docker image at build time (see Dockerfile's
# WHISPER_MODEL / WHISPER_CPP_VERSION build args). To switch models WITHOUT rebuilding:
# download a different ggml-*.bin from https://huggingface.co/ggerganov/whisper.cpp,
# mount it into the container (e.g. add it to the /data volume), and point
# WHISPER_MODEL_PATH at it. No code change or rebuild needed.
WHISPER_BIN=whisper-cli
WHISPER_MODEL_PATH=/app/models/ggml-base.bin
FFMPEG_BIN=ffmpeg
WHISPER_TIMEOUT_MS=120000
# Separate, more generous timeout for the actual transcription step (whisper-cli itself).
# Transcription time scales with both audio length and model size — a larger/more-accurate
# model (small/medium/large-v3/large-v3-turbo) transcribing 1-2 minutes of audio can easily
# take several minutes on modest CPU hardware. Raise further if you still see
# "whisper-cli timed out" errors with a large model on a slow host.
WHISPER_TRANSCRIBE_TIMEOUT_MS=600000
# Timeout for the lightweight binary/ffmpeg checks behind GET /v1/health?details=true
WHISPER_HEALTH_TIMEOUT_MS=5000
# Concurrent transcription jobs allowed at once. Keep at 1 on small/shared VPS
# instances — whisper.cpp is CPU/RAM-heavy and this also protects chat requests
# running on the same box from being starved.
WHISPER_MAX_CONCURRENT=1
# Max upload size for POST /v1/audio/transcriptions (bytes). Default 25MB, matching OpenAI's limit.
MAX_AUDIO_BYTES=26214400
# Default language when a request doesn't specify one. "auto" lets whisper.cpp detect
# it per-request; pinning a specific ISO-639-1 code (e.g. "en") skips detection and can
# improve both speed and accuracy if you know every request will be one language.
WHISPER_LANGUAGE=auto
# Pin whisper.cpp's CPU thread count. Leave unset to let it auto-detect (usually
# min(4, core count)) — set explicitly on a small/shared VPS to cap CPU usage per
# transcription job, e.g. WHISPER_THREADS=1 on a single-vCPU box.
WHISPER_THREADS=
